# UPRISE Discord Bot Configuration
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""
DISCORD_GUILD_ID=""

# Database Configuration (SQLite for MVP, points to local file in data/uprise.db)
DATABASE_URL="file:./data/uprise.db"

# XP Configuration (Configurable values)
XP_VERIFICATION=100
XP_REFERRAL=250

# Role and Channel IDs
NEW_MEMBER_ROLE_ID=""
COMMUNITY_MEMBER_ROLE_ID=""
BOT_LOG_CHANNEL_ID=""

# Dynamic Voice Channels
# "➕ Create VC" hub: joining it creates a private channel for the member
VC_HUB_CHANNEL_ID=""
# Category for created channels (defaults to the hub's category)
VC_CATEGORY_ID=""

# Scheduled Event Voice Channels
EVENT_VC_CATEGORY_ID=""
# Where "event is now open" alerts are posted (overridable per event)
EVENT_ANNOUNCE_CHANNEL_ID=""
# Role allowed to use /event-vc in addition to members with Manage Events
EVENT_MANAGER_ROLE_ID=""

# Port Configuration
PORT=3000

